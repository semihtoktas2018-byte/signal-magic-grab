# ------------------------------------------------------------------
# KELTOŞ — Ortam Değişkenleri Örneği
# Bu dosyayı ".env" olarak kopyalayın ve kendi Supabase projenizin
# değerleriyle doldurun. .env dosyasını ASLA commit etmeyin.
# ------------------------------------------------------------------

# Frontend (Vite build sırasında gömülür) — publishable/anon key herkese açıktır.
VITE_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="<PROJECT_REF>"

# Sunucu tarafı (yalnızca yerel geliştirme). Production'da bu değerleri
# repoya değil, Supabase Secrets / hosting env değişkenlerine girin.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="<PROJECT_REF>"

# ------------------------------------------------------------------
# GİZLİ ANAHTARLAR — bu dosyaya veya repoya YAZILMAZ.
# Bunlar yalnızca Supabase Edge Function Secrets içine elle girilir:
#   SUPABASE_SERVICE_ROLE_KEY   (Supabase Dashboard → Project Settings → API)
#   TELEGRAM_BOT_TOKEN          (Telegram @BotFather'dan)
#   CRON_SECRET                 (uzun rastgele değer; pg_cron ile aynı olmalı)
# Detay için SETUP.md'ye bakın.
# ------------------------------------------------------------------
